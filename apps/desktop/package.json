{
  "name": "@datam8/desktop",
  "productName": "DataM8",
  "desktopName": "datam8",
  "version": "2.0.1",
  "private": true,
  "description": "DataM8 Desktop App",
  "homepage": "https://github.com/oraylis/datam8-frontend",
  "author": "DataM8",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "node ../../scripts/watch-desktop.mjs",
    "start": "electron .",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && node --test ../../scripts/backend-startup.test.mjs ../../scripts/backend-env.test.mjs ../../scripts/backend-lifecycle.test.mjs ../../scripts/mac-runtime.test.mjs ../../scripts/desktop-update-feed.test.mjs ../../scripts/desktop-updates.test.mjs ../../scripts/developer-simulation.test.mjs ../../scripts/watch-desktop.test.mjs ../../scripts/dev-vite.test.mjs ../../scripts/check-font-assets.test.mjs",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config build.config.cjs --publish never"
  },
  "build": {
    "appId": "com.datam8",
    "productName": "DataM8",
    "executableName": "datam8",
    "electronVersion": "42.4.0",
    "deb": {
      "packageName": "datam8",
      "artifactName": "datam8_${version}_${arch}.${ext}"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "resources/**/*",
      "!dist/developerSimulation.*",
      "!resources/dev-fixtures.*",
      "!resources/cleanup-dev-profile.cjs",
      "!resources/*.d.cts",
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "extraResources": [
      {
        "from": "../../artifacts/python-runtime",
        "to": "python-runtime"
      },
      {
        "from": "build/icons",
        "to": "assets/icons"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "dm8s",
        "name": "DataM8 Solution",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico",
      "signExts": [
        ".dll",
        ".node",
        ".pyd"
      ],
      "signtoolOptions": {
        "sign": "../../scripts/sign-windows.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "artifactName": "DataM8-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DataM8"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "DataM8",
        "CFBundleName": "DataM8"
      },
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "DataM8-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "DataM8",
      "icon": "build/icons/icon-512.png",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oraylis",
        "repo": "datam8-frontend"
      }
    ],
    "afterPack": "../../scripts/desktop-after-pack.cjs"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  }
}
