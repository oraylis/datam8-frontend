{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@datam8/types": ["packages/types/src"],
      "@datam8/types/*": ["packages/types/src/*"],
      "@datam8/ui": ["packages/ui/src"],
      "@datam8/ui/*": ["packages/ui/src/*"]
    }
  }
}
